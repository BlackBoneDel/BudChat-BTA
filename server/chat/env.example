# ============================================================================
# CONFIGURACIÓN DEL SERVIDOR DE BUDCHAT (tu app de chat)
# ----------------------------------------------------------------------------
# Copiar a /etc/budsin-chat.env (install.sh lo hace con modo 0640, root:budsin-chat)
# y editar con tus valores. Reiniciar con: sudo systemctl restart budsin-chat
# ============================================================================

# --- Red del servidor (no cambia) ---
CHAT_PORT=3104
CHAT_HOST=127.0.0.1
CHAT_DATA_DIR=/var/lib/budsin-chat

# --- Firebase: TU PROYECTO (el chat solo usa Auth de Google) ---
# Id del proyecto Firebase. El token se verifica sin librerías contra los
# certificados públicos de Google; no necesitas API key del servidor.
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# --- Administradores del chat (correos de Google verificados) ---
# Los mismos que entran en /chat/admin.html. Separados por comas.
CHAT_ADMIN_EMAILS=tu-admin@tudominio.com

# --- Orígenes que pueden abrir el WebSocket (separados por comas) ---
# Debe coincidir con el dominio donde se sirva la app.
CHAT_ORIGINS=https://chat.example.com

# --- Imágenes, stickers y audios (por defecto: CHAT_DATA_DIR/media) ---
CHAT_MEDIA_DIR=/var/lib/budsin-chat/media
# Detector NSFW local (solo si CHAT_IMAGES=1). Instalar con WITH_SCAN=1.
CHAT_SCAN_URL=http://127.0.0.1:3105

# Umbral de probabilidad "sexual" a partir del cual se rechaza una imagen
# (0 a 1; más bajo = más estricto).
CHAT_NSFW_THRESHOLD=0.35

# --- IMÁGENES Y STICKERS PROPIOS ---
# Apagado por defecto (0). Con 1 se aceptan subidas de imágenes y fotos de perfil.
# NO activarlo con menores en el sitio sin una defensa real contra CSAM:
# el detector NSFW incluido NO la sustituye (ver README).
# Notas de voz y stickers predefinidos funcionan siempre.
CHAT_IMAGES=0

# --- QUIÉN PUEDE ENTRAR ---
# Por defecto solo cuentas de Google de colegios/universidades (correo verificado):
#   *.edu , *.edu.?? (ucv.edu.pe, unam.edu.mx...) y *.ac.?? (ox.ac.uk).
# Los admins entran siempre. Para tu app, definir tus dominios (acepta subdominios):
#   tu-colegio.com           ese dominio exacto + sus subdominios
#   *                       sin restricción (cualquiera con cuenta Google verificada)
CHAT_ALLOWED_DOMAINS=*.edu,*.edu.??,*.ac.??

# --- Enlaces permitidos en los mensajes (con sus subdominios; máx. 2 por mensaje) ---
# Vacío = ningún enlace. Mantén consistente con ALLOWED_LINKS de public/chat/chat-config.js.
CHAT_ALLOWED_LINKS=chat.example.com,google.com
