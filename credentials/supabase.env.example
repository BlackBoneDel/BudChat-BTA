# === Supabase credentials ===
# Copia este archivo como supabase.env y pega los valores reales.
# Nunca commites el supabase.env real (está en .gitignore).

# ---- Proyecto ----
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica

# ---- Auth: OAuth (solo si activas estos proveedores) ----
SUPABASE_GOOGLE_CLIENT_ID=
SUPABASE_GOOGLE_CLIENT_SECRET=
SUPABASE_GITHUB_CLIENT_ID=
SUPABASE_GITHUB_CLIENT_SECRET=

# ---- Auth: Email (opcional, si usas magic link / password) ----
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASSWORD=
SUPABASE_EMAIL_REDIRECT=
