# === Cloudflare credentials ===
# Copia este archivo como cloudflare.env y pega los valores reales.
# Nunca commites el cloudflare.env real (está en .gitignore).

# ---- Para desplegar con el CLI (wrangler / pages) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- Proyecto Cloudflare Pages (para referencia) ----
PAGES_PROJECT_NAME=budsin-chat

# ---- Variables que el frontend necesita (se pasan a Pages en build) ----
# Estas se inyectan como VITE_* para que Vite las empiece con VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
